msgid "Please choose the source for {version_name}."
msgstr "Please choose the source for {version_name}."

msgid ""
"Warning: using the system-provided version instead of the GXDE-modified "
"version may cause some GXDE behavior, such as blur effects, to differ from "
"the intended experience."
msgstr ""
"Warning: using the system-provided version instead of the GXDE-modified "
"version may cause some GXDE behavior, such as blur effects, to differ from "
"the intended experience."

