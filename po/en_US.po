msgid "Git clone failed: "
msgstr "Git clone failed: "

msgid "Invalid input. Please try again."
msgstr "Invalid input. Please try again."

msgid ""
"The integer you have input exceeded the range required, please try again."
msgstr ""
"The integer you have input exceeded the range required, please try again."

msgid "(DIR)> "
msgstr "(DIR)> "

msgid "Invalid directory path. Please try again."
msgstr "Invalid directory path. Please try again."

msgid "The path is not a directory. Please try again."
msgstr "The path is not a directory. Please try again."

msgid "The directory does not exist. Please try again."
msgstr "The directory does not exist. Please try again."

msgid "Failed to create the directory: "
msgstr "Failed to create the directory: "

msgid "The directory is not empty. Please try again."
msgstr "The directory is not empty. Please try again."

msgid "Failed to access the directory: "
msgstr "Failed to access the directory: "

msgid "None of supported package managers were detected, halted!"
msgstr "None of supported package managers were detected, halted!"

msgid "Please choose from following repository sources:"
msgstr "Please choose from following repository sources:"

msgid "  1. Gitee official"
msgstr "  1. Gitee official"

msgid "  2. GiHub official"
msgstr "  2. GiHub official"

msgid "  3. Manually entering mirror source"
msgstr "  3. Manually entering mirror source"

msgid "Do you want to use SSH?"
msgstr "Do you want to use SSH?"

msgid ""
"Third-party mirror sources are maintained by their respective providers and "
"are not verified by the GXDE project. Before continuing, please make sure "
"that you trust the selected source. The GXDE project is not responsible for "
"issues caused by third-party sources."
msgstr ""
"Third-party mirror sources are maintained by their respective providers and "
"are not verified by the GXDE project. Before continuing, please make sure "
"that you trust the selected source. The GXDE project is not responsible for "
"issues caused by third-party sources."

msgid "Still proceed?"
msgstr "Still proceed?"

msgid "Please enter the mirror source URL."
msgstr "Please enter the mirror source URL."

msgid "URL)> "
msgstr ""

msgid "We are now using: "
msgstr "We are now using: "

msgid "<REPO_NAME>"
msgstr "<REPO_NAME>"

msgid "Is that correct?"
msgstr "Is that correct?"

msgid "Please enter the working directory."
msgstr "Please enter the working directory."

msgid "Failed to clone repository: "
msgstr "Failed to clone repository: "

msgid "Installation failed due to error occurred."
msgstr "Installation failed because an error occurred."

msgid "Successfully cloned repository: "
msgstr "Successfully cloned repository: "

msgid "PM Test hit: Advanced Packaging Tools."
msgstr "PM Test hit: Advanced Packaging Tools."

msgid "Successfully generated installation scripts for repository: "
msgstr "Successfully generated installation scripts for repository: "

msgid "Failed to start package build: "
msgstr "Failed to start package build: "

msgid "Failed to build repository: "
msgstr "Failed to build repository: "

msgid "Successfully built repository: "
msgstr "Successfully built repository: "

msgid "Installing dtk2 dependencies..."
msgstr "Installing DTK2 dependencies..."

msgid "GXDE Desktop Environment Installer"
msgstr "GXDE Desktop Environment Installer"

msgid "Please ensure that you have NOT installed Deepin DDE..."
msgstr "Please ensure that you have NOT installed Deepin DDE..."

msgid ""
"For GXDE relys on old version of DDE components, which may be conflict with "
"Deepin DDE."
msgstr ""
"For GXDE relys on old version of DDE components, which may be conflict with "
"Deepin DDE."

msgid ""
"If you have installed UKUI Wayland session then you may only use GXDE X11 "
"session..."
msgstr ""
"If you have installed UKUI Wayland session then you may only use GXDE X11 "
"session..."

msgid ""
"For GXDE's Wayland compositor is based on Kylin's Wayland compositor, which "
"may be conflict with UKUI Wayland compositor."
msgstr ""
"For GXDE's Wayland compositor is based on Kylin's Wayland compositor, which "
"may be conflict with UKUI Wayland compositor."

msgid "Still proceed with the installation?"
msgstr "Still proceed with the installation?"

