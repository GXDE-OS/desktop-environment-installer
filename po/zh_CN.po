msgid "Git clone failed: "
msgstr "Git克隆失败："

msgid "Invalid input. Please try again."
msgstr "输入无效，请重试..."

msgid ""
"The integer you have input exceeded the range required, please try again."
msgstr "您输入的整数超出预期范围，请重试..."

msgid "(DIR)> "
msgstr "(路径)> "

msgid "Invalid directory path. Please try again."
msgstr "目录路径无效，请重试..."

msgid "The path is not a directory. Please try again."
msgstr "该路径不是目录，请重试..."

msgid "The directory does not exist. Please try again."
msgstr "该目录不存在，请重试..."

msgid "Failed to create the directory: "
msgstr "无法创建目录："

msgid "The directory is not empty. Please try again."
msgstr "该目录不为空，请重试..."

msgid "Failed to access the directory: "
msgstr "无法访问目录："

msgid "None of supported package managers were detected, halted!"
msgstr "未找到支持的包管理器，安装工具现已退出..."

msgid "Failed to save installation resume state: "
msgstr "保存安装续跑状态失败："

msgid "Failed to load installation resume state: "
msgstr "加载安装续跑状态失败："

msgid "The installation resume state is invalid."
msgstr "安装续跑状态无效。"

msgid "Legacy resume state created; restarting from module: "
msgstr "已创建旧工作目录的续跑状态，将从此模块重新开始："

msgid "No previous module checkout was found; restarting from the beginning."
msgstr "未找到之前检出的模块，将从头开始。"

msgid "Please choose from following repository sources:"
msgstr "请选择仓库的来源："

msgid "  1. Gitee official"
msgstr "  1. Gitee (码云) 上的GXDE-OS"

msgid "  2. GitHub official"
msgstr "  2. GitHub上的GXDE-OS"

msgid "  3. Manually entering mirror source"
msgstr "  3. 手动配置镜像源"

msgid "Do you want to use SSH?"
msgstr "您想要使用SSH吗？"

msgid ""
"Third-party mirror sources are maintained by their respective providers and "
"are not verified by the GXDE project. Before continuing, please make sure "
"that you trust the selected source. The GXDE project is not responsible for "
"issues caused by third-party sources."
msgstr ""
"第三方镜像源由相应的提供者维护，未经GXDE项目验证。继续前，请确认您信任所选的"
"镜像源。GXDE项目不对使用第三方源所导致的问题负责。"

msgid "Still proceed?"
msgstr "还要继续吗？"

msgid "Please enter the mirror source URL."
msgstr "请输入镜像源的地址。"

msgid "URL)> "
msgstr "地址)> "

msgid "We are now using: "
msgstr "我们当前使用的源地址是: "

msgid "<REPO_NAME>"
msgstr "<仓库名>"

msgid "Is that correct?"
msgstr "对吗？"

msgid "Please enter the previous working directory."
msgstr "请输入上次安装使用的工作目录。"

msgid "Loaded installation resume state from: "
msgstr "已从此处加载安装续跑状态："

msgid "No resume state was found; reconstructing the previous run."
msgstr "未找到续跑状态，正在根据旧工作目录重建上次运行进度。"

msgid "Please enter the working directory."
msgstr "请输入工作目录。"

msgid "Warning: no supported package manager adapter is available."
msgstr "警告：没有可用的受支持包管理器适配器。"

msgid "Resume: reusing existing repository checkout: "
msgstr "续跑：复用现有仓库检出："

msgid "Failed to clone repository: "
msgstr "克隆仓库失败："

msgid "Installation failed due to error occurred."
msgstr "发生错误，安装失败。"

msgid "Successfully cloned repository: "
msgstr "仓库克隆成功："

msgid "Detected package manager: "
msgstr "检测到包管理器："

msgid "Successfully generated installation scripts for repository: "
msgstr "已为仓库成功生成安装脚本："

msgid "Failed to start package build: "
msgstr "启动软件包构建失败："

msgid "Failed to build repository: "
msgstr "构建仓库失败："

msgid "Successfully built repository: "
msgstr "仓库构建成功："

msgid "Warning: invalid artifact archive name: "
msgstr "警告：无效的产物归档名称："

msgid "Warning: failed to read the artifacts directory: "
msgstr "警告：读取产物目录失败："

msgid "Warning: no package artifacts were found in: "
msgstr "警告：在以下目录中未找到软件包产物："

msgid "Warning: failed to create the package installation process: "
msgstr "警告：创建软件包安装进程失败："

msgid "Warning: failed to start package installation: "
msgstr "警告：启动软件包安装失败："

msgid "Warning: failed while waiting for package installation: "
msgstr "警告：等待软件包安装时发生错误："

msgid "Warning: failed to install the current stage: "
msgstr "警告：当前阶段安装失败："

msgid "Warning: failed to archive installed packages: "
msgstr "警告：归档已安装的软件包失败："

msgid "Successfully installed the current stage: "
msgstr "当前阶段安装成功："

msgid "Archived installed packages in: "
msgstr "已安装的软件包已归档至："

msgid "DTK2 original compatibility dependencies"
msgstr "DTK2原版兼容层依赖"

msgid "DTK2 Qt6 port compatibility dependencies"
msgstr "DTK2 Qt6移植版兼容层依赖"

msgid "Installing module stage: "
msgstr "正在安装模块阶段："

msgid "Resume: package artifacts are missing; rebuilding repository: "
msgstr "续跑：软件包产物已不在根产物目录，重新构建仓库："

msgid "Resume: skipping completed repository build: "
msgstr "续跑：跳过已完成的仓库构建："

msgid "Resume: skipping completed repository installation: "
msgstr "续跑：跳过已完成的仓库安装："

msgid "Resume: skipping completed module stage: "
msgstr "续跑：跳过已完成的模块阶段："

#, python-brace-format
msgid "Resume: using the saved source choice for {version_name}."
msgstr "续跑：使用已保存的{version_name}来源选择。"

#, python-brace-format
msgid "Please choose the source for {version_name}."
msgstr "请选择{version_name}的来源。"

msgid ""
"Warning: using the system-provided version instead of the GXDE-modified "
"version may cause some GXDE behavior, such as blur effects, to differ from "
"the intended experience."
msgstr ""
"警告：若使用系统提供的版本而非GXDE修改版，GXDE的部分行为（例如模糊效果）可能"
"与预期体验不一致。"

msgid ""
"Warning: installing the GXDE-modified version may change DTK behavior in "
"other desktop sessions. GXDE does not guarantee that DTK applications will "
"behave as expected outside the GXDE session."
msgstr ""
"警告：安装GXDE修改版可能会改变其他桌面会话中的DTK行为。GXDE不保证DTK应用在"
"GXDE会话之外的行为符合预期。"

#, python-brace-format
msgid "Build and install the GXDE-modified version of {version_name}?"
msgstr "要构建并安装GXDE修改版{version_name}吗？"

msgid "Using the system-provided DTK5 packages."
msgstr "将使用系统提供的DTK5软件包。"

msgid "Using the system-provided DTK6 packages."
msgstr "将使用系统提供的DTK6软件包。"

msgid "GXDE infrastructure dependencies"
msgstr "GXDE基础设施依赖"

msgid "GXDE core"
msgstr "GXDE核心组件"

msgid "Warning: failed to install optional component: "
msgstr "警告：可选组件安装失败："

msgid "Successfully installed optional component: "
msgstr "可选组件安装成功："

msgid "Resume: using the saved GXDE session choice."
msgstr "续跑：使用已保存的GXDE会话选择。"

msgid "Please choose the GXDE session type to install:"
msgstr "请选择要安装的GXDE会话类型："

msgid "  1. X11 session (including compositor)"
msgstr "  1. X11会话（包含合成器）"

msgid "  2. Wayland session (including compositor)"
msgstr "  2. Wayland会话（包含合成器）"

msgid "  3. Both X11 and Wayland sessions"
msgstr "  3. 同时安装X11和Wayland会话"

msgid "GXDE X11 session and compositor"
msgstr "GXDE X11会话与合成器"

msgid "GXDE Wayland session and compositor"
msgstr "GXDE Wayland会话与合成器"

msgid "Resume: using the saved APM choice."
msgstr "续跑：使用已保存的APM选择。"

msgid "Install APM (Amber Package Manager)?"
msgstr "要安装APM（琥珀软件包管理器）吗？"

msgid "Resume: skipping completed optional component: APM"
msgstr "续跑：跳过已完成的可选组件：APM"

msgid "Skipping APM installation."
msgstr "跳过APM安装。"

msgid ""
"The installation recorded in this working directory is already complete."
msgstr "此工作目录记录的安装已经完成。"

msgid "Installation completed; resume state has been saved."
msgstr "安装完成，续跑状态已保存。"

msgid "Build and install the GXDE desktop environment."
msgstr "构建并安装GXDE桌面环境。"

msgid "Continue from the last incomplete step in a previous working directory."
msgstr "从之前工作目录中最后一个未完成的步骤继续。"

msgid "GXDE Desktop Environment Installer"
msgstr "GXDE桌面环境安装器"

msgid "Please ensure that you have NOT installed Deepin DDE..."
msgstr "请确保您的系统上未安装深度DDE桌面环境..."

msgid ""
"For GXDE relys on old version of DDE components, which may be conflict with "
"Deepin DDE."
msgstr "原因是GXDE依赖某些旧版DDE组件，所以GXDE会与DDE冲突。"

msgid ""
"If you have installed UKUI Wayland session then you may only use GXDE X11 "
"session..."
msgstr "如果您装了麒麟的UKUI桌面，请您仅安装X11会话..."

msgid ""
"For GXDE's Wayland compositor is based on Kylin's Wayland compositor, which "
"may be conflict with UKUI Wayland compositor."
msgstr "原因是GXDE的Wayland合成器修改自麒麟的合成器，我们不想造成任何冲突..."

msgid "Still proceed with the installation?"
msgstr "还要继续安装吗？"

msgid "You have chosen to exit the installation process."
msgstr "您已经取消了安装流程。"

#~ msgid "Installing dtk2 dependencies..."
#~ msgstr "正在安装 DTK2 依赖..."
